# -----------------------------------------------------------------------------
# ONIONLENS 360 — .gitignore
# Covers: Next.js / Vite / React, Python / FastAPI, Docker, Supabase, secrets
# -----------------------------------------------------------------------------

# -- Secrets & environment -----------------------------------------------------
.env
.env.local
.env.*.local
.env.development
.env.production
backend/.env
frontend/.env

# Allow production frontend API configuration for Vercel
!frontend/.env.production

# Keep .env.example files — they are safe to commit
!.env.example
!backend/.env.example
!frontend/.env.example
# -- Python --------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.egg
*.egg-info/
eggs/
.installed.cfg
lib64/

# Virtual environments
venv/
.venv/
env/
ENV/
virtualenv/
.virtualenvs/

# pyenv
.python-version

# pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
coverage.xml
*.cover

# mypy
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# Jupyter
.ipynb_checkpoints
*.ipynb

# -- Node / Frontend -----------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Vite build output
frontend/dist/
frontend/.vite/

# Next.js build output (if migrated)
.next/
out/
next-env.d.ts

# Generic build / cache
build/
.cache/
.parcel-cache/
.turbo/

# TypeScript
*.tsbuildinfo

# -- Databases (dev only) ------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# -- Generated / runtime storage ----------------------------------------------
backend/storage/originals/
backend/storage/videos/
backend/storage/frames/
backend/uploads/
backend/evidence/
backend/reports/

# Keep demo dataset (small images needed for demo mode)
!backend/storage/dataset/
!backend/storage/dataset/**

# -- ML model weights ---------------------------------------------------------
*.pt
*.pth
*.onnx
*.tflite
*.h5
*.pkl
*.bin
models/
backend/models/

# -- OS / editor ---------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# -- Logs ---------------------------------------------------------------------
*.log
logs/

# -- Test artefacts ------------------------------------------------------------
test_output/
test_results/

# -- Misc ---------------------------------------------------------------------
*.bak
*.tmp
*.temp
.eslintcache
.stylelintcache
