# ONIONLENS 360 — Environment Variables
# Copy this file to backend/.env and frontend/.env and fill in your values.

# ─────────────────────────────────────────
# BACKEND (backend/.env)
# ─────────────────────────────────────────

# Database — SQLite for dev, PostgreSQL/Supabase for production
DATABASE_URL=sqlite:///./onionlens.db
# DATABASE_URL=postgresql://user:password@host:5432/onionlens

# Supabase (optional — for managed PostgreSQL + storage)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-role-key

# Auth
SECRET_KEY=change-this-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App mode
DEMO_MODE=true

# Storage directories (relative to backend/ or absolute)
UPLOAD_DIR=storage/originals
VIDEO_DIR=storage/videos
FRAMES_DIR=storage/frames
EVIDENCE_DIR=storage/evidence
REPORTS_DIR=storage/reports
DATASET_DIR=storage/dataset

# CV / Model
MODEL_PATH=models/yolov8n.pt
INFERENCE_EVERY_N_FRAMES=5
MAX_FRAMES_PER_ONION=3

# Confidence gates
CONFIDENCE_GATE_ACCEPT=0.85
CONFIDENCE_GATE_REVIEW=0.60

# Active model version label
ACTIVE_MODEL_VERSION=v0.3-demo
ACTIVE_MODEL_NAME=OnionLens YOLO v0.3-demo

# ─────────────────────────────────────────
# FRONTEND (frontend/.env)
# ─────────────────────────────────────────

# API URL — leave empty for local dev (uses Vite proxy to localhost:8000)
# Set to your deployed backend URL for production:
# VITE_API_URL=https://your-backend.railway.app
VITE_API_URL=
