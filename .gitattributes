# Normalize line endings
* text=auto

# Force LF for shell scripts and source files deployed to Linux
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.css text eol=lf
*.html text eol=lf
*.txt text eol=lf
Dockerfile text eol=lf
Procfile text eol=lf

# Windows batch files — keep CRLF
*.bat text eol=crlf

# Binary — no conversion
*.jpg binary
*.png binary
*.pdf binary
*.pt binary
*.pth binary
*.onnx binary
