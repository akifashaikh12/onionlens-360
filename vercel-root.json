{
  "version": 2,
  "builds": [
    {
      "src": "onionlens360/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://your-backend.railway.app/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/onionlens360/frontend/dist/$1"
    }
  ]
}
